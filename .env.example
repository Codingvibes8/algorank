# Local env — copy values into `.env.local` (git-ignored, never commit).
# `.env.example` itself is force-added to git so setup stays documented.

# Stripe Checkout (server-side, via the Stripe MCP server).
# STRIPE_SECRET_KEY is server-only — NEVER prefix it with NEXT_PUBLIC_.
# Test mode (scriptorcode sandbox):
#   STRIPE_PILOT_PRICE_ID=price_1UQbX2ROID58K8APnbxNc7b1
#   STRIPE_GROWTH_MONTHLY_PRICE_ID=price_1UQbYBROID58K8APcit3a3mK
#   STRIPE_GROWTH_QUARTERLY_PRICE_ID=price_1UQbYEROID58K8APkrercTQA
STRIPE_SECRET_KEY=
STRIPE_PILOT_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_QUARTERLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional: override the app origin used for Stripe success/cancel URLs.
# Leave blank in dev (uses the request origin); set in production, e.g.
# https://algorank.co.uk
NEXT_PUBLIC_APP_URL=

# Optional legacy Stripe Payment Link for the £249 pilot (https://buy.stripe.com/…).
# Leave blank — pilot buttons use /api/checkout, falling back to #audit.
NEXT_PUBLIC_STRIPE_PILOT_URL=

# Cal.com / Calendly scheduling URL for discovery calls (https://…).
# Leave blank until created — booking section shows an email fallback.
NEXT_PUBLIC_CAL_URL=

# Audit form storage — Supabase project (server-side only).
# NEVER expose the service-role key publicly. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
